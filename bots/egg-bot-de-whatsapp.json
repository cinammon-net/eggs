    "scripts": {
        "installation": {
            "script": "#!/bin/bash\n# Bot de WhatsApp (Baileys): si el servidor está vacío, deja una plantilla lista para vincular el número.\n# Si ya hay un bot (package.json, requirements.txt o el archivo principal), no se toca nada.\nset -e\nmkdir -p /mnt/server\ncd /mnt/server\nif [ -f package.json ] || [ -f requirements.txt ] || [ -f \"${MAIN_FILE:-index.js}\" ]; then\n    echo \"Ya hay un bot en el servidor: no se cambia nada.\"\n    exit 0\nfi\ncat > package.json <<'CIN_PKG'\n{\n  \"name\": \"bot-whatsapp\",\n  \"version\": \"1.0.0\",\n  \"description\": \"Bot de WhatsApp con Baileys (plantilla de Cinammon)\",\n  \"main\": \"index.js\",\n  \"private\": true,\n  \"scripts\": { \"start\": \"node index.js\" },\n  \"dependencies\": {\n    \"@whiskeysockets/baileys\": \"^6.7.18\",\n    \"pino\": \"^9.5.0\",\n    \"qrcode\": \"^1.5.4\"\n  }\n}\nCIN_PKG\ncat > \"${MAIN_FILE:-index.js}\" <<'CIN_BOT'\n/**\n * Bot de WhatsApp con Baileys · plantilla de Cinammon\n *\n * Vincular el número (solo la primera vez):\n *  - Con código: pon tu número en la variable \"Número de WhatsApp\" del panel (con prefijo, sin + ni espacios,\n *    p. ej. 34600111222), enciende el servidor y copia el código que sale en la consola.\n *    En el móvil: WhatsApp → Dispositivos vinculados → Vincular un dispositivo → Vincular con el número de teléfono.\n *  - Con QR: deja la variable vacía y escanea el QR del recuadro \"Conexión con WhatsApp\" del panel.\n * Todo se hace desde el recuadro \"Conexión con WhatsApp\" de la consola del panel (número, código y QR).\n * La sesión se guarda en la carpeta \"sesion\": no hace falta volver a vincular al reiniciar.\n * Si cierras la sesión desde el móvil, borra la carpeta \"sesion\" y vuelve a vincular.\n */\nconst { default: makeWASocket, useMultiFileAuthState, DisconnectReason, fetchLatestBaileysVersion, Browsers } = require('@whiskeysockets/baileys');\nconst fs = require('fs');\nconst pino = require('pino');\nconst QR = require('qrcode');\n\nconst PREFIX = '!';\nconst NUMBER = String(process.env.WA_NUMBER || '').replace(/\\D/g, '');\n\n// Comandos: añade aquí los tuyos\nconst commands = {\n    ping: async ({ reply }) => reply('Pong. El bot funciona.'),\n    menu: async ({ reply }) => reply(`*Menú*\\n${PREFIX}ping · comprobar que el bot responde\\n${PREFIX}menu · ver los comandos\\n${PREFIX}hora · la hora del servidor`),\n    hora: async ({ reply }) => reply(new Date().toLocaleString('es-ES', { timeZone: 'Europe/Madrid' })),\n};\n\nlet pairingAsked = false;\n\n/** Estado para la sección \"WhatsApp\" del panel (whatsapp-estado.json). No lo borres. */\nfunction estado(data) {\n    try {\n        fs.writeFileSync('whatsapp-estado.json', JSON.stringify({ numero: NUMBER || null, ...data, at: new Date().toISOString() }));\n    } catch { /* sin permisos: el panel lo detecta por la consola */ }\n}\n\nasync function start() {\n    estado({ estado: 'iniciando' });\n    const { state, saveCreds } = await useMultiFileAuthState('sesion');\n    const { version } = await fetchLatestBaileysVersion().catch(() => ({ version: undefined }));\n    const sock = makeWASocket({\n        version,\n        auth: state,\n        logger: pino({ level: 'silent' }),\n        browser: Browsers.ubuntu('Chrome'),\n        markOnlineOnConnect: false,\n    });\n    sock.ev.on('creds.update', saveCreds);\n\n    sock.ev.on('connection.update', async ({ connection, lastDisconnect, qr }) => {\n        if (qr && !sock.authState.creds.registered) {\n            if (NUMBER && !pairingAsked) {\n                pairingAsked = true;\n                try {\n                    const code = await sock.requestPairingCode(NUMBER);\n                    const pretty = code.match(/.{1,4}/g).join('-');\n                    estado({ estado: 'codigo', codigo: pretty });\n                    console.log(`\\nCódigo de vinculación: ${pretty}`);\n                    console.log('WhatsApp → Dispositivos vinculados → Vincular con el número de teléfono\\n');\n                } catch (e) {\n                    estado({ estado: 'error', error: `No se pudo pedir el código: ${e.message}` });\n                    console.log('No se pudo pedir el código:', e.message);\n                }\n            } else if (!NUMBER) {\n                estado({ estado: 'qr', qr: await QR.toDataURL(qr, { margin: 1, width: 320 }).catch(() => null) });\n                // El QR sale solo en el recuadro del panel (no se repite en la consola)\n                console.log('QR listo: escanéalo en el recuadro \"Conexión con WhatsApp\" de la consola del panel (WhatsApp → Dispositivos vinculados).');\n            }\n        }\n        if (connection === 'open') {\n            const me = sock.user?.id?.split(':')[0] || null;\n            estado({ estado: 'conectado', usuario: me, nombre: sock.user?.name || null });\n            console.log(`Conectado a WhatsApp como ${me || 'tu número'}.`);\n        }\n        if (connection === 'close') {\n            const code = lastDisconnect?.error?.output?.statusCode;\n            if (code === DisconnectReason.loggedOut) {\n                estado({ estado: 'cerrado' });\n                console.log('La sesión se ha cerrado desde el móvil. Borra la carpeta \"sesion\" y reinicia para vincular de nuevo.');\n                return;\n            }\n            estado({ estado: 'reconectando' });\n            console.log('Conexión perdida, reconectando...');\n            setTimeout(start, 3000);\n        }\n    });\n\n    sock.ev.on('messages.upsert', async ({ messages, type }) => {\n        if (type !== 'notify') return;\n        for (const m of messages) {\n            if (!m.message || m.key.fromMe) continue;\n            const text = m.message.conversation || m.message.extendedTextMessage?.text || m.message.imageMessage?.caption || '';\n            if (!text.startsWith(PREFIX)) continue;\n            const [name, ...args] = text.slice(PREFIX.length).trim().split(/\\s+/);\n            const cmd = commands[name?.toLowerCase()];\n            if (!cmd) continue;\n            const reply = (t) => sock.sendMessage(m.key.remoteJid, { text: t }, { quoted: m });\n            try {\n                await cmd({ sock, m, args, reply });\n            } catch (e) {\n                console.log(`Error en ${PREFIX}${name}:`, e.message);\n            }\n        }\n    });\n}\n\nprocess.on('unhandledRejection', (e) => console.log('Error:', e?.message || e));\nstart();\nCIN_BOT\nnpm install --omit=dev --no-audit --no-fund || echo \"Las dependencias se instalarán al encender el servidor.\"\necho \"Plantilla de Baileys instalada. Enciende el servidor para vincular tu número.\"\n",
            "container": "node:22-bookworm",
            "entrypoint": "bash"
        }
    },
