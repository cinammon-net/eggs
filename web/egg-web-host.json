    "scripts": {
        "installation": {
            "script": "#!/bin/bash\n# Cinammon WebHost · instalación\nset -e\ncd /mnt/server\n\necho \"▸ Preparando dependencias…\"\napt-get update -qq\napt-get install -y -qq git curl wget unzip ca-certificates >/dev/null\n\necho \"▸ Descargando la configuración base de Nginx y PHP-FPM…\"\nrm -rf ./temp\ngit clone --depth 1 https://github.com/BernyCampos/pelican-webhost ./temp\n# La configuración se actualiza siempre; los archivos de tu web (webroot/) nunca se sobrescriben.\nrm -rf /mnt/server/nginx /mnt/server/php-fpm\ncp -r ./temp/nginx /mnt/server/\ncp -r ./temp/php-fpm /mnt/server/\nmkdir -p /mnt/server/webroot /mnt/server/tmp /mnt/server/logs\nrm -rf ./temp\n\necho \"▸ Instalando el arranque de Cinammon…\"\ncat > /mnt/server/start.sh <<'CINAMMON_START_EOF'\n#!/bin/ash\n# Cinammon WebHost · arranque de PHP-FPM + Nginx\nP='\\033[1;35m'; C='\\033[1;36m'; G='\\033[0;32m'; Y='\\033[1;33m'; R='\\033[0;31m'; D='\\033[2m'; N='\\033[0m'\nok()   { echo -e \"${G}  ✔ $1${N}\"; }\nwarn() { echo -e \"${Y}  ⚠ $1${N}\"; }\nfail() { echo -e \"${R}  ✖ $1${N}\"; }\n\necho -e \"${P}\"\necho -e \"   ╔═════════════════════════════════════╗\"\necho -e \"   ║        ${C}C I N A M M O N${P}  ·  WEBHOST      ║\"\necho -e \"   ╚═════════════════════════════════════╝${N}\"\necho -e \"${D}   Nginx + PHP $(php -r 'echo PHP_VERSION;' 2>/dev/null)${N}\\n\"\n\necho -e \"${C}▸ Limpiando temporales…${N}\"\nmkdir -p /home/container/tmp /home/container/logs\nrm -rf /home/container/tmp/* && ok \"Temporales limpios\" || warn \"No se pudieron limpiar los temporales\"\n\nif [ ! -f /home/container/webroot/index.php ] && [ ! -f /home/container/webroot/index.html ]; then\n    warn \"webroot/ no tiene index.php ni index.html: sube tu web desde Archivos o por SFTP.\"\nfi\n\necho -e \"${C}▸ Iniciando PHP-FPM…${N}\"\nif /usr/sbin/php-fpm8 --fpm-config /home/container/php-fpm/php-fpm.conf --daemonize; then\n    ok \"PHP-FPM en marcha\"\nelse\n    fail \"PHP-FPM no arrancó. Revisa php-fpm/php-fpm.conf\"\n    exit 1\nfi\n\necho -e \"${C}▸ Iniciando Nginx…${N}\"\nif /usr/sbin/nginx -t -c /home/container/nginx/nginx.conf -p /home/container/ >/dev/null 2>&1; then\n    ok \"Configuración de Nginx correcta\"\nelse\n    fail \"Error en la configuración de Nginx:\"\n    /usr/sbin/nginx -t -c /home/container/nginx/nginx.conf -p /home/container/\n    exit 1\nfi\n\necho -e \"\\n${G}  ● Web en línea${N}  ${C}http://${SERVER_IP:-tu-ip}:${SERVER_PORT:-puerto}${N}\"\necho -e \"${D}    Archivos de la web: webroot/   ·   Registros: logs/${N}\\n\"\n/usr/sbin/nginx -c /home/container/nginx/nginx.conf -p /home/container/\n\ntail -f /dev/null\nCINAMMON_START_EOF\nchmod +x /mnt/server/start.sh\n\ncd /mnt/server/webroot\n\n# Página de bienvenida: solo si webroot está vacío o tiene la de ejemplo.\nput_welcome() {\ncat > /mnt/server/webroot/index.php <<'CINAMMON_INDEX_EOF'\n<?php\n$site = htmlspecialchars(getenv('SITE_NAME') ?: 'Mi web en Cinammon', ENT_QUOTES, 'UTF-8');\n$php = PHP_VERSION;\n$port = htmlspecialchars($_SERVER['SERVER_PORT'] ?? '', ENT_QUOTES, 'UTF-8');\n?><!doctype html>\n<html lang=\"es\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title><?= $site ?> · Cinammon WebHost</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<style>\n:root{--bg:#04060d;--card:#0a0e1c;--line:rgba(255,255,255,.08);--text:#e2e8f0;--muted:#94a3b8;--pink:#ff2d95;--cyan:#00f7ff;--violet:#a855f7}\n*{box-sizing:border-box}html,body{margin:0}\nbody{min-height:100vh;background:var(--bg);color:var(--text);font-family:Inter,system-ui,sans-serif;display:flex;align-items:center;justify-content:center;padding:32px 16px;overflow-x:hidden}\nbody:before{content:\"\";position:fixed;inset:0;background:radial-gradient(600px 400px at 15% 10%,rgba(0,247,255,.12),transparent 60%),radial-gradient(600px 400px at 85% 90%,rgba(255,45,149,.12),transparent 60%),radial-gradient(circle,rgba(255,255,255,.07) 1px,transparent 1px) 0 0/24px 24px;pointer-events:none}\n.wrap{position:relative;width:100%;max-width:760px}\n.top{height:1px;background:linear-gradient(90deg,transparent,var(--pink),var(--cyan),transparent);margin-bottom:28px}\n.badge{display:inline-flex;align-items:center;gap:8px;border:1px solid rgba(0,247,255,.35);background:rgba(0,247,255,.08);color:var(--cyan);border-radius:999px;padding:6px 14px;font:600 11px Orbitron,sans-serif;letter-spacing:.18em;text-transform:uppercase}\n.dot{width:8px;height:8px;border-radius:50%;background:#34d399;box-shadow:0 0 10px #34d399;animation:p 1.6s infinite}@keyframes p{50%{opacity:.35}}\nh1{font:900 clamp(28px,6vw,46px)/1.1 Orbitron,sans-serif;margin:18px 0 10px;letter-spacing:.02em}\nh1 span{background:linear-gradient(90deg,var(--pink),var(--violet),var(--cyan));-webkit-background-clip:text;background-clip:text;color:transparent}\n.lead{color:var(--muted);font-size:16px;line-height:1.6;margin:0 0 28px}\n.grid{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(210px,1fr))}\n.card{background:linear-gradient(180deg,rgba(255,255,255,.035),rgba(255,255,255,.01));border:1px solid var(--line);border-radius:16px;padding:18px;transition:border-color .2s,transform .2s}\n.card:hover{border-color:rgba(255,45,149,.45);transform:translateY(-2px)}\n.n{font:700 12px Orbitron,sans-serif;color:var(--pink);letter-spacing:.15em}\n.card h2{font:700 15px Orbitron,sans-serif;margin:8px 0 6px}\n.card p{margin:0;color:var(--muted);font-size:13.5px;line-height:1.55}\ncode{font:500 12.5px ui-monospace,Menlo,monospace;color:var(--cyan);background:rgba(0,247,255,.08);border:1px solid rgba(0,247,255,.2);border-radius:6px;padding:1px 6px}\n.stats{display:flex;flex-wrap:wrap;gap:10px;margin:26px 0}\n.stat{border:1px solid var(--line);background:var(--card);border-radius:12px;padding:10px 14px;font-size:12px;color:var(--muted)}\n.stat b{display:block;color:var(--text);font:700 14px Orbitron,sans-serif;margin-top:2px}\n.cta{display:inline-flex;align-items:center;gap:8px;text-decoration:none;font:700 13px Orbitron,sans-serif;color:#fff;background:linear-gradient(90deg,var(--pink),#c026d3);border-radius:12px;padding:12px 20px;box-shadow:0 0 22px rgba(255,45,149,.35)}\n.cta.alt{background:transparent;border:1px solid rgba(0,247,255,.45);color:var(--cyan);box-shadow:none}\n.actions{display:flex;flex-wrap:wrap;gap:12px}\nfooter{margin-top:34px;color:#64748b;font-size:12px}\nfooter a{color:var(--muted)}\n</style>\n</head>\n<body>\n<main class=\"wrap\">\n  <div class=\"top\"></div>\n  <span class=\"badge\"><span class=\"dot\"></span> Online · Cinammon WebHost</span>\n  <h1><?= $site ?><br><span>ya está en línea</span></h1>\n  <p class=\"lead\">Tu servidor web (Nginx + PHP) funciona. Esta es la página de bienvenida: sustitúyela por tu web siguiendo uno de estos caminos.</p>\n\n  <div class=\"grid\">\n    <div class=\"card\"><div class=\"n\">01</div><h2>Sube tus archivos</h2><p>En el panel: <b>Archivos</b> → carpeta <code>webroot/</code>. O por SFTP (puerto <code>2022</code>) con los datos de <b>Acceso SFTP</b>. Borra este <code>index.php</code>.</p></div>\n    <div class=\"card\"><div class=\"n\">02</div><h2>Instala WordPress</h2><p>En <b>Inicio</b> pon <code>Instalar WordPress</code> a <code>1</code> y pulsa <b>Reinstalar</b>. Necesitarás una base de datos (pestaña <b>Bases de datos</b>).</p></div>\n    <div class=\"card\"><div class=\"n\">03</div><h2>Despliega con Git</h2><p>Pon la URL de tu repositorio en <code>Repositorio Git</code> y reinstala. Para repos privados, añade usuario y token.</p></div>\n  </div>\n\n  <div class=\"stats\">\n    <div class=\"stat\">PHP<b><?= htmlspecialchars($php, ENT_QUOTES, 'UTF-8') ?></b></div>\n    <div class=\"stat\">Servidor<b>Nginx</b></div>\n    <?php if ($port): ?><div class=\"stat\">Puerto<b><?= $port ?></b></div><?php endif; ?>\n    <div class=\"stat\">Subida máx.<b>100 MB</b></div>\n  </div>\n\n  <div class=\"actions\">\n    <a class=\"cta\" href=\"https://panel.cinammon.net/servers\" target=\"_blank\" rel=\"noopener\">Abrir mi panel →</a>\n    <a class=\"cta alt\" href=\"https://store.cinammon.net/store/web\" target=\"_blank\" rel=\"noopener\">Ampliar mi plan</a>\n  </div>\n\n  <footer>Alojado en <a href=\"https://cinammon.net\" target=\"_blank\" rel=\"noopener\">Cinammon Network</a> · Infraestructura cloud para comunidades.</footer>\n</main>\n</body>\n</html>\nCINAMMON_INDEX_EOF\n}\n\nif [[ \"${WORDPRESS}\" == \"true\" || \"${WORDPRESS}\" == \"1\" ]]; then\n    if [[ -f wp-config.php || -f wp-config-sample.php ]]; then\n        echo \"✔ WordPress ya estaba instalado: no se toca.\"\n    else\n        echo \"▸ Instalando WordPress (última versión en español)…\"\n        wget -q https://es.wordpress.org/latest-es_ES.tar.gz -O wp.tar.gz || wget -q https://wordpress.org/latest.tar.gz -O wp.tar.gz\n        tar xzf wp.tar.gz\n        rm -f index.php\n        cp -r wordpress/. .\n        rm -rf wordpress wp.tar.gz\n        echo \"✔ WordPress instalado. Abre tu web para terminar la configuración (crea antes una base de datos en el panel).\"\n    fi\nelif [[ \"${USER_UPLOAD}\" == \"true\" || \"${USER_UPLOAD}\" == \"1\" ]]; then\n    echo \"✔ Modo «solo mis archivos»: webroot/ no se modifica.\"\nelif [[ -n \"${GIT_ADDRESS}\" ]]; then\n    [[ ${GIT_ADDRESS} != *.git ]] && GIT_ADDRESS=${GIT_ADDRESS}.git\n    if [[ -n \"${USERNAME}\" && -n \"${ACCESS_TOKEN}\" ]]; then\n        GIT_ADDRESS=\"https://${USERNAME}:${ACCESS_TOKEN}@$(echo ${GIT_ADDRESS} | cut -d/ -f3-)\"\n    fi\n    if [[ -d .git ]]; then\n        echo \"▸ Actualizando el repositorio…\"\n        git pull\n    elif [[ -z \"$(ls -A .)\" || ( -f index.php && $(ls -A | wc -l) -eq 1 && $(grep -c -E 'Berny WebHost|Cinammon WebHost' index.php) -gt 0 ) ]]; then\n        rm -f index.php\n        echo \"▸ Clonando el repositorio…\"\n        if [[ -z \"${BRANCH}\" ]]; then git clone ${GIT_ADDRESS} .; else git clone --single-branch --branch ${BRANCH} ${GIT_ADDRESS} .; fi\n    else\n        echo \"⚠ webroot/ ya tiene archivos y no es un repositorio Git: no se clona para no borrar nada.\"\n    fi\nelse\n    if [[ -z \"$(ls -A .)\" ]] || grep -q -E 'Berny WebHost|Cinammon WebHost' index.php 2>/dev/null; then\n        put_welcome\n        echo \"✔ Página de bienvenida de Cinammon creada en webroot/index.php\"\n    else\n        echo \"✔ webroot/ ya tiene tu web: no se modifica.\"\n    fi\nfi\n\necho \"✔ Instalación completada\"\n",
            "container": "ghcr.io/parkervcp/installers:ubuntu",
