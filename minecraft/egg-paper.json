    "scripts": {
        "installation": {
            "script": "#!/bin/ash\n# Paper Installation Script for Cinammon.net\nPROJECT=paper\n\nif [ -n \"${DL_PATH}\" ]; then\n    echo -e \"Using supplied download url: ${DL_PATH}\"\n    DOWNLOAD_URL=$(eval echo $(echo ${DL_PATH} | sed -e 's/{{/${/g' -e 's/}}/}/g'))\nelse\n    API_PROJECT=$(curl -s -H \"User-Agent: curl/8.4.0\" \"https://fill.papermc.io/v3/projects/${PROJECT}\")\n\n    if [ \"${MINECRAFT_VERSION}\" = \"latest\" ] || [ -z \"${MINECRAFT_VERSION}\" ]; then\n        MINECRAFT_VERSION=$(echo \"$API_PROJECT\" | jq -r '.versions | to_entries | .[].value[]' | grep -v '-' | head -n1)\n    fi\n\n    echo -e \"Minecraft Version: ${MINECRAFT_VERSION}\"\n\n    API_BUILDS=$(curl -s -H \"User-Agent: curl/8.4.0\" \"https://fill.papermc.io/v3/projects/${PROJECT}/versions/${MINECRAFT_VERSION}\")\n\n    if [ \"${BUILD_NUMBER}\" = \"latest\" ] || [ -z \"${BUILD_NUMBER}\" ]; then\n        BUILD_NUMBER=$(echo \"$API_BUILDS\" | jq -r '.builds | max')\n    fi\n\n    echo -e \"Paper Build: ${BUILD_NUMBER}\"\n\n    API_BUILD_INFO=$(curl -s -H \"User-Agent: curl/8.4.0\" \"https://fill.papermc.io/v3/projects/${PROJECT}/versions/${MINECRAFT_VERSION}/builds/${BUILD_NUMBER}\")\n    DOWNLOAD_URL=$(echo \"$API_BUILD_INFO\" | jq -r '.downloads[\"server:default\"].url // empty')\n\n    if [ -z \"$DOWNLOAD_URL\" ]; then\n        JAR_NAME=$(echo \"$API_BUILD_INFO\" | jq -r '.downloads[\"server:default\"].name // \"'\"${PROJECT}-${MINECRAFT_VERSION}-${BUILD_NUMBER}.jar\"'\"')\n        DOWNLOAD_URL=\"https://fill.papermc.io/v3/projects/${PROJECT}/versions/${MINECRAFT_VERSION}/builds/${BUILD_NUMBER}/downloads/${JAR_NAME}\"\n    fi\nfi\n\ncd /mnt/server\n\necho -e \"Downloading Paper server from: ${DOWNLOAD_URL}\"\n\nif [ -f \"${SERVER_JARFILE}\" ]; then\n    mv \"${SERVER_JARFILE}\" \"${SERVER_JARFILE}.old\"\nfi\n\ncurl -sSL -H \"User-Agent: curl/8.4.0\" -o \"${SERVER_JARFILE}\" \"${DOWNLOAD_URL}\"\n\nif [ ! -f server.properties ]; then\n    echo -e \"Creating default server.properties\"\n    cat << 'EOF' > server.properties\nserver-ip=0.0.0.0\nserver-port=25565\nquery.port=25565\nmotd=A Cinammon.net Minecraft Server\nEOF\nfi\n\nif [ ! -d mods ]; then\n    mkdir -p mods\nfi\nif [ ! -d plugins ]; then\n    mkdir -p plugins\nfi\n\necho -e \"Paper installation complete!\"\n",
